---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';
import CopyCodeButton from '../components/CopyCodeButton.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import KeyboardNav from '../components/KeyboardNav.astro';
import ContentLicense from '../components/ContentLicense.astro';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string };

const { title, description, pubDate, updatedDate, heroImage, slug } = Astro.props;

// Get adjacent posts for navigation
const allPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const currentIndex = allPosts.findIndex(p => p.slug === slug);
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const pageUrl = Astro.url.href;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<ReadingProgress />
		<Header />
		<main class="py-12 md:py-20">
			<article class="max-w-2xl mx-auto px-4 sm:px-6">
				<!-- Header -->
				<header class="mb-12">
					<div class="mb-4">
						<a href="/blog" class="text-sm text-slate-500 hover:text-slate-300 transition-colors">
							← Back to all posts
						</a>
					</div>
					<time class="text-sm text-slate-400 font-medium">
						<FormattedDate date={pubDate} />
					</time>
					<h1 class="text-3xl md:text-4xl font-bold text-slate-200 mt-3 mb-6 leading-tight">
						{title}
					</h1>
					{description && (
						<p class="text-xl text-slate-400 leading-relaxed">
							{description}
						</p>
					)}
					{updatedDate && (
						<p class="text-sm text-slate-500 mt-3 italic">
							Last updated on <FormattedDate date={updatedDate} />
						</p>
					)}
				</header>

				<!-- Hero Image -->
				{heroImage && (
					<div class="mb-12">
						<Image width={800} height={420} src={heroImage} alt="" class="w-full rounded-lg" />
					</div>
				)}

				<!-- Content -->
				<div class="prose prose-invert prose-lg prose-slate max-w-none
					prose-headings:font-bold
					prose-p:leading-relaxed
					prose-a:text-blue-400 prose-a:underline hover:prose-a:text-blue-300
					prose-strong:font-semibold
					prose-code:bg-slate-800 prose-code:rounded prose-code:px-1.5 prose-code:py-0.5 prose-code:before:content-none prose-code:after:content-none
					prose-pre:bg-slate-800 prose-pre:rounded-lg
					prose-blockquote:border-blue-500
					prose-img:rounded-lg prose-hr:border-slate-700">
					<slot />
				</div>

				<!-- Share Buttons -->
				<ShareButtons title={title} url={pageUrl} description={description} />

				<!-- Content License -->
				{slug && <ContentLicense slug={slug} />}

				<!-- Previous/Next Navigation -->
				<div class="mt-12 flex flex-col sm:flex-row sm:justify-between gap-4 border-t border-slate-800 pt-8">
					{prevPost && (
						<a href={`/blog/${prevPost.slug}`} data-nav="prev"
						   class="text-blue-400 hover:underline text-sm">
							← Previous: {prevPost.data.title}
						</a>
					)}
					{nextPost && (
						<a href={`/blog/${nextPost.slug}`} data-nav="next"
						   class="text-blue-400 hover:underline text-sm sm:text-right ml-auto">
							Next: {nextPost.data.title} →
						</a>
					)}
				</div>

				<!-- Keyboard Navigation -->
				<KeyboardNav />

				<!-- Copy Code Buttons -->
				<CopyCodeButton />
			</article>
		</main>
		<Footer />
	</body>
</html>
