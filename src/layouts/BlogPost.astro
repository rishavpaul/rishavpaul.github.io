---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* Medium-inspired typography */
			.article-content {
				font-family: 'Georgia', 'Times New Roman', serif;
				line-height: 1.8;
				font-size: 1.125rem;
				color: #d1d5db;
			}

			.article-content h1,
			.article-content h2,
			.article-content h3 {
				font-family: ui-sans-serif, system-ui, sans-serif;
				font-weight: 600;
				color: #f3f4f6;
				margin-top: 2em;
				margin-bottom: 0.5em;
				line-height: 1.3;
			}

			.article-content h1 { font-size: 2rem; }
			.article-content h2 { font-size: 1.5rem; }
			.article-content h3 { font-size: 1.25rem; }

			.article-content p {
				margin-bottom: 2em;
			}

			.article-content strong {
				display: block;
				margin-top: 2em;
				margin-bottom: 0.5em;
				color: #f3f4f6;
				font-weight: 600;
			}

			.article-content strong:first-child {
				margin-top: 0;
			}

			.article-content a {
				color: #60a5fa;
				text-decoration: underline;
				text-decoration-color: #3b82f6;
				text-underline-offset: 2px;
			}

			.article-content a:hover {
				color: #93c5fd;
			}

			.article-content ul,
			.article-content ol {
				margin-bottom: 2em;
				padding-left: 1.5em;
				color: #d1d5db;
			}

			.article-content ul {
				list-style-type: disc;
			}

			.article-content ol {
				list-style-type: decimal;
			}

			.article-content li {
				margin-bottom: 0.75em;
				padding-left: 0.5em;
			}

			.article-content blockquote {
				border-left: 3px solid #3b82f6;
				padding-left: 1em;
				margin: 1.5em 0;
				font-style: italic;
				color: #9ca3af;
			}

			.article-content code {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.875em;
				background: #1f2937;
				padding: 0.2em 0.4em;
				border-radius: 4px;
			}

			.article-content pre {
				background: #1f2937;
				padding: 1em;
				border-radius: 8px;
				overflow-x: auto;
				margin-bottom: 1.5em;
			}

			.article-content pre code {
				background: transparent;
				padding: 0;
			}

			.article-content img {
				border-radius: 8px;
				margin: 2em 0;
			}

			.article-content hr {
				border: none;
				border-top: 1px solid #374151;
				margin: 2em 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="py-12 md:py-20">
			<article class="max-w-2xl mx-auto px-4 sm:px-6">
				<!-- Header -->
				<header class="mb-12">
					<div class="mb-4">
						<a href="/blog" class="text-sm text-slate-500 hover:text-slate-300 transition-colors">
							← Back to all posts
						</a>
					</div>
					<time class="text-sm text-slate-500 font-medium">
						<FormattedDate date={pubDate} />
					</time>
					<h1 class="text-3xl md:text-4xl font-bold text-slate-100 mt-3 mb-6 leading-tight">
						{title}
					</h1>
					{description && (
						<p class="text-xl text-slate-400 leading-relaxed">
							{description}
						</p>
					)}
					{updatedDate && (
						<p class="text-sm text-slate-500 mt-3 italic">
							Last updated on <FormattedDate date={updatedDate} />
						</p>
					)}
				</header>

				<!-- Hero Image -->
				{heroImage && (
					<div class="mb-12">
						<Image width={800} height={420} src={heroImage} alt="" class="w-full rounded-lg" />
					</div>
				)}

				<!-- Content -->
				<div class="article-content">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
