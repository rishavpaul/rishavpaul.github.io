---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container-custom py-16 md:py-24">
			<section class="max-w-2xl mx-auto">
				<h1 class="mb-12">Writing</h1>
				<ul class="space-y-12">
					{
						posts.map((post) => (
							<li class="group">
								<a href={`/blog/${post.id}/`} class="block">
									<div class="flex items-center gap-3 mb-2">
										<time class="text-sm text-slate-500 font-medium">
											<FormattedDate date={post.data.pubDate} />
										</time>
									</div>
									<h2 class="text-xl font-semibold text-slate-200 group-hover:text-white transition-colors mb-2">
										{post.data.title}
									</h2>
									<p class="text-slate-400 leading-relaxed">
										{post.data.description}
									</p>
									<div class="mt-3 text-sm text-blue-400 group-hover:text-blue-300 transition-colors">
										Read more
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
