---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ReadingTime from '../../components/ReadingTime.astro';
import TagList from '../../components/TagList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { calculateReadingTime } from '../../utils/reading-time';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Collect all unique tags
const allTags = Array.from(new Set(posts.flatMap(post => post.data.tags || [])));

// Enrich posts with reading time
const postsWithMeta = posts.map(post => ({
	...post,
	readingMinutes: calculateReadingTime(post.body),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content" class="container-custom py-16 md:py-24">
			<section class="max-w-3xl mx-auto">
				<h1 class="mb-12">Writing</h1>

				<!-- Tag Filter -->
				{allTags.length > 0 && (
					<div class="mb-8 flex flex-wrap gap-2">
						<button class="tag-filter px-3 py-1.5 rounded-md text-sm font-medium text-slate-300 border border-slate-700 hover:border-slate-600 transition-colors active bg-slate-800" data-tag="all">
							All
						</button>
						{allTags.map(tag => (
							<button class="tag-filter px-3 py-1.5 rounded-md text-sm font-medium text-slate-400 border border-slate-800 hover:border-slate-700 transition-colors" data-tag={tag}>
								{tag}
							</button>
						))}
					</div>
				)}

				<ul class="space-y-12">
					{
						postsWithMeta.map((post) => (
							<li class="post-item group" data-tags={JSON.stringify(post.data.tags || [])}>
								<a href={`/blog/${post.id}/`} class="block">
									<div class="flex flex-wrap items-center gap-3 mb-2">
										<time class="text-sm text-slate-500 font-medium">
											<FormattedDate date={post.data.pubDate} />
										</time>
										<span class="text-slate-600">•</span>
										<span class="text-sm text-slate-400">
											{post.readingMinutes} min read
										</span>
									</div>
									<h2 class="text-xl font-semibold text-slate-200 group-hover:text-white transition-colors mb-2">
										{post.data.title}
									</h2>
									<p class="text-slate-400 leading-relaxed mb-3">
										{post.data.description}
									</p>
									{post.data.tags && post.data.tags.length > 0 && (
										<div class="mb-2">
											<TagList tags={post.data.tags} />
										</div>
									)}
									<div class="mt-3 text-sm text-blue-400 group-hover:text-blue-300 transition-colors">
										Read more
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const filterButtons = document.querySelectorAll('.tag-filter');
	const postItems = document.querySelectorAll('.post-item');

	filterButtons.forEach(button => {
		button.addEventListener('click', () => {
			const selectedTag = button.getAttribute('data-tag');

			// Update active state
			filterButtons.forEach(btn => {
				btn.classList.remove('active', 'border-slate-600', 'text-slate-300', 'bg-slate-800');
				btn.classList.add('border-slate-800', 'text-slate-400');
			});
			button.classList.add('active', 'border-slate-600', 'text-slate-300', 'bg-slate-800');
			button.classList.remove('border-slate-800', 'text-slate-400');

			// Filter posts
			postItems.forEach(item => {
				const tags = JSON.parse(item.getAttribute('data-tags') || '[]');

				if (selectedTag === 'all') {
					item.style.display = '';
				} else if (tags.includes(selectedTag)) {
					item.style.display = '';
				} else {
					item.style.display = 'none';
				}
			});
		});
	});
</script>
