---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR } from '../consts';

const title = 'Projects';
const description = 'A showcase of my technical projects, contributions, and work';

// Example project structure - you'll fill this in later
const projects = [
	{
		title: '[Project Name]',
		description: '[Brief description of the project, problem it solves, and your role]',
		technologies: ['Tech 1', 'Tech 2', 'Tech 3'],
		links: {
			github: '',
			demo: '',
			case_study: '',
		},
		highlights: [
			'[Key achievement or metric]',
			'[Technical challenge overcome]',
			'[Impact or result]',
		],
	},
	// Add more projects...
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_AUTHOR}`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article class="projects">
				<h1>{title}</h1>
				<p class="intro">
					A selection of projects that demonstrate my technical skills, problem-solving approach, and impact.
				</p>

				<div class="projects-grid">
					{projects.map((project) => (
						<div class="project-card">
							<h2>{project.title}</h2>
							<p class="description">{project.description}</p>

							<div class="technologies">
								{project.technologies.map((tech) => (
									<span class="tech-tag">{tech}</span>
								))}
							</div>

							{project.highlights && project.highlights.length > 0 && (
								<ul class="highlights">
									{project.highlights.map((highlight) => (
										<li>{highlight}</li>
									))}
								</ul>
							)}

							<div class="project-links">
								{project.links.github && (
									<a href={project.links.github} target="_blank" rel="noopener noreferrer">
										GitHub
									</a>
								)}
								{project.links.demo && (
									<a href={project.links.demo} target="_blank" rel="noopener noreferrer">
										Live Demo
									</a>
								)}
								{project.links.case_study && (
									<a href={project.links.case_study}>
										Case Study
									</a>
								)}
							</div>
						</div>
					))}
				</div>

				<section class="open-source">
					<h2>Open Source Contributions</h2>
					<p>
						[Summary of your open source work, notable contributions to major projects, or your own maintained projects]
					</p>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.projects {
		max-width: 1000px;
		margin: 0 auto;
	}

	.projects h1 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.intro {
		font-size: 1.1rem;
		color: #666;
		margin-bottom: 3rem;
		line-height: 1.6;
	}

	.projects-grid {
		display: grid;
		gap: 2.5rem;
		margin-bottom: 4rem;
	}

	.project-card {
		padding: 2rem;
		background: #f9f9f9;
		border-radius: 12px;
		border: 1px solid #e0e0e0;
	}

	.project-card h2 {
		font-size: 1.75rem;
		margin-bottom: 1rem;
		color: #333;
	}

	.description {
		line-height: 1.6;
		color: #555;
		margin-bottom: 1.25rem;
	}

	.technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}

	.tech-tag {
		padding: 0.35rem 0.75rem;
		background: #fff;
		border: 1px solid #ddd;
		border-radius: 4px;
		font-size: 0.85rem;
		color: #555;
	}

	.highlights {
		margin: 1.25rem 0;
		padding-left: 1.5rem;
	}

	.highlights li {
		margin-bottom: 0.5rem;
		line-height: 1.5;
		color: #555;
	}

	.project-links {
		display: flex;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.project-links a {
		padding: 0.5rem 1rem;
		background: #333;
		color: white;
		text-decoration: none;
		border-radius: 6px;
		font-size: 0.9rem;
		transition: background 0.2s;
	}

	.project-links a:hover {
		background: #555;
	}

	.open-source {
		margin-top: 4rem;
		padding: 2rem;
		background: #f0f8ff;
		border-radius: 12px;
	}

	.open-source h2 {
		font-size: 1.75rem;
		margin-bottom: 1rem;
		color: #333;
	}

	.open-source p {
		line-height: 1.6;
		color: #555;
	}

	/* Dark mode styles */
	:global(.dark) .intro {
		color: #94a3b8;
	}

	:global(.dark) .project-card {
		background: #1e293b;
		border-color: #334155;
	}

	:global(.dark) .project-card h2 {
		color: #f1f5f9;
	}

	:global(.dark) .description {
		color: #cbd5e1;
	}

	:global(.dark) .tech-tag {
		background: #0f172a;
		border-color: #334155;
		color: #cbd5e1;
	}

	:global(.dark) .highlights li {
		color: #cbd5e1;
	}

	:global(.dark) .project-links a {
		background: #f1f5f9;
		color: #0f172a;
	}

	:global(.dark) .project-links a:hover {
		background: #cbd5e1;
	}

	:global(.dark) .open-source {
		background: #1e3a5f;
	}

	:global(.dark) .open-source h2 {
		color: #f1f5f9;
	}

	:global(.dark) .open-source p {
		color: #cbd5e1;
	}
</style>
