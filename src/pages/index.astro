---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_AUTHOR, PROFESSIONAL_INFO, SOCIAL_LINKS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<StructuredData type="person" />
	</head>
	<body>
		<Header />
		<main class="container-custom py-16 md:py-24">
			<!-- Hero Section -->
			<section class="max-w-4xl mx-auto text-center mb-24">
				<div class="mb-6">
					<h1 class="mb-4">
						Hi, I'm <span class="gradient-text">{SITE_AUTHOR}</span>
					</h1>
					<p class="text-2xl md:text-3xl text-slate-600 font-medium mb-6">
						{PROFESSIONAL_INFO.jobTitle}
					</p>
				</div>
				<p class="text-lg md:text-xl text-slate-700 max-w-3xl mx-auto leading-relaxed">
					[Brief introduction about your background, expertise, and what you're passionate about building. Keep it concise and compelling - 2-3 sentences max.]
				</p>
				<div class="mt-10 flex flex-wrap gap-4 justify-center">
					{SOCIAL_LINKS.github && (
						<a
							href={SOCIAL_LINKS.github}
							target="_blank"
							rel="noopener noreferrer"
							class="px-6 py-3 bg-slate-900 text-white rounded-lg hover:bg-slate-800 transition-colors inline-flex items-center gap-2"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" clip-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z"/>
							</svg>
							GitHub
						</a>
					)}
					{SOCIAL_LINKS.linkedin && (
						<a
							href={SOCIAL_LINKS.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors inline-flex items-center gap-2"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd"/>
							</svg>
							LinkedIn
						</a>
					)}
					{SOCIAL_LINKS.email && (
						<a
							href={`mailto:${SOCIAL_LINKS.email}`}
							class="px-6 py-3 border-2 border-slate-300 text-slate-700 rounded-lg hover:border-slate-400 hover:bg-slate-50 transition-colors inline-flex items-center gap-2"
						>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
							</svg>
							Email
						</a>
					)}
				</div>
			</section>

			<!-- What I Do Section -->
			<section class="mb-24">
				<div class="text-center mb-12">
					<h2 class="text-3xl md:text-4xl font-bold mb-4">What I Do</h2>
					<p class="text-lg text-slate-600 max-w-2xl mx-auto">
						Building scalable systems and leading technical initiatives
					</p>
				</div>
				<div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
					<div class="bg-white p-8 rounded-xl border border-slate-200 card-hover">
						<div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold mb-3">System Design & Architecture</h3>
						<p class="text-slate-600">
							[Description of your experience with distributed systems, microservices, scalability patterns, and architectural decision-making]
						</p>
					</div>

					<div class="bg-white p-8 rounded-xl border border-slate-200 card-hover">
						<div class="w-12 h-12 bg-cyan-100 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold mb-3">Full-Stack Development</h3>
						<p class="text-slate-600">
							[Description of your technical stack, frameworks you excel with, and end-to-end delivery capabilities]
						</p>
					</div>

					<div class="bg-white p-8 rounded-xl border border-slate-200 card-hover">
						<div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold mb-3">Technical Leadership</h3>
						<p class="text-slate-600">
							[Description of your experience leading teams, mentoring engineers, driving technical strategy, and cross-functional collaboration]
						</p>
					</div>
				</div>
			</section>

			<!-- Featured Projects Teaser -->
			<section class="bg-gradient-to-br from-slate-50 to-blue-50 rounded-2xl p-12 text-center">
				<h2 class="text-3xl md:text-4xl font-bold mb-4">Featured Work</h2>
				<p class="text-lg text-slate-600 mb-8 max-w-2xl mx-auto">
					Explore my portfolio of projects showcasing technical depth, problem-solving, and impact
				</p>
				<a
					href="/projects"
					class="inline-flex items-center gap-2 px-8 py-4 bg-slate-900 text-white rounded-lg hover:bg-slate-800 transition-colors text-lg font-medium"
				>
					View Projects
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
