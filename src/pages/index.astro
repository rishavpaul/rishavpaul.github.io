---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_AUTHOR, PROFESSIONAL_INFO, SOCIAL_LINKS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<StructuredData type="person" />
	</head>
	<body>
		<Header />
		<main class="container-custom py-16 md:py-24">
			<!-- Hero Section -->
			<section class="max-w-4xl mx-auto text-center mb-24">
				<div class="mb-6">
					<h1 class="mb-4">
						Hi, I'm <span class="gradient-text">{SITE_AUTHOR}</span>
					</h1>
					<p class="text-2xl md:text-3xl text-slate-600 font-medium mb-6">
						{PROFESSIONAL_INFO.jobTitle}
					</p>
				</div>
				<p class="text-lg md:text-xl text-slate-700 max-w-3xl mx-auto leading-relaxed">
					[Brief introduction about your background, expertise, and what you're passionate about building. Keep it concise and compelling - 2-3 sentences max.]
				</p>
				<div class="mt-10 flex flex-wrap gap-4 justify-center">
					{SOCIAL_LINKS.github && (
						<a
							href={SOCIAL_LINKS.github}
							target="_blank"
							rel="noopener noreferrer"
							class="px-6 py-3 bg-slate-900 text-white rounded-lg hover:bg-slate-800 transition-colors inline-flex items-center gap-2"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.840 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.430.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
							</svg>
							GitHub
						</a>
					)}
					{SOCIAL_LINKS.linkedin && (
						<a
							href={SOCIAL_LINKS.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors inline-flex items-center gap-2"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
							LinkedIn
						</a>
					)}
					{SOCIAL_LINKS.email && (
						<a
							href={`mailto:${SOCIAL_LINKS.email}`}
							class="px-6 py-3 border-2 border-slate-300 text-slate-700 rounded-lg hover:border-slate-400 hover:bg-slate-50 transition-colors inline-flex items-center gap-2"
						>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
							</svg>
							Email
						</a>
					)}
				</div>
			</section>

			<!-- What I Do Section -->
			<section class="mb-24">
				<div class="text-center mb-12">
					<h2 class="text-3xl md:text-4xl font-bold mb-4">What I Do</h2>
					<p class="text-lg text-slate-600 max-w-2xl mx-auto">
						Building scalable systems and leading technical initiatives
					</p>
				</div>
				<div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
					<div class="bg-white p-8 rounded-xl border border-slate-200 card-hover">
						<div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold mb-3">System Design & Architecture</h3>
						<p class="text-slate-600">
							[Description of your experience with distributed systems, microservices, scalability patterns, and architectural decision-making]
						</p>
					</div>

					<div class="bg-white p-8 rounded-xl border border-slate-200 card-hover">
						<div class="w-12 h-12 bg-cyan-100 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold mb-3">Full-Stack Development</h3>
						<p class="text-slate-600">
							[Description of your technical stack, frameworks you excel with, and end-to-end delivery capabilities]
						</p>
					</div>

					<div class="bg-white p-8 rounded-xl border border-slate-200 card-hover">
						<div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold mb-3">Technical Leadership</h3>
						<p class="text-slate-600">
							[Description of your experience leading teams, mentoring engineers, driving technical strategy, and cross-functional collaboration]
						</p>
					</div>
				</div>
			</section>

			<!-- Featured Projects Teaser -->
			<section class="bg-gradient-to-br from-slate-50 to-blue-50 rounded-2xl p-12 text-center">
				<h2 class="text-3xl md:text-4xl font-bold mb-4">Featured Work</h2>
				<p class="text-lg text-slate-600 mb-8 max-w-2xl mx-auto">
					Explore my portfolio of projects showcasing technical depth, problem-solving, and impact
				</p>
				<a
					href="/projects"
					class="inline-flex items-center gap-2 px-8 py-4 bg-slate-900 text-white rounded-lg hover:bg-slate-800 transition-colors text-lg font-medium"
				>
					View Projects
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
