---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_AUTHOR, PROFESSIONAL_INFO, SOCIAL_LINKS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<StructuredData type="person" />
	</head>
	<body>
		<Header />
		<main class="container-custom py-16 md:py-24">
			<!-- Hero Section -->
			<section class="max-w-3xl mx-auto mb-24">
				<h1 class="mb-6">{SITE_AUTHOR}</h1>
				<p class="text-xl text-slate-300 mb-8 leading-relaxed">
					I build backend systems that scale to billions of requests.
					Currently leading platform infrastructure at HubSpot.
				</p>
				<div class="flex flex-wrap gap-4">
					{SOCIAL_LINKS.github && (
						<a
							href={SOCIAL_LINKS.github}
							target="_blank"
							rel="noopener noreferrer"
							class="px-5 py-2.5 border border-slate-600 text-slate-300 hover:border-slate-400 hover:text-white hover:bg-slate-800 transition-colors rounded-md text-sm font-medium"
						>
							GitHub
						</a>
					)}
					{SOCIAL_LINKS.linkedin && (
						<a
							href={SOCIAL_LINKS.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							class="px-5 py-2.5 border border-slate-600 text-slate-300 hover:border-slate-400 hover:text-white hover:bg-slate-800 transition-colors rounded-md text-sm font-medium"
						>
							LinkedIn
						</a>
					)}
				</div>
			</section>

			<!-- Experience Section -->
			<section class="mb-24">
				<h2 class="mb-10">Experience</h2>
				<div class="max-w-3xl mx-auto space-y-6">
					<!-- HubSpot -->
					<div class="card card-hover">
						<div class="flex items-start justify-between gap-4 mb-3">
							<div>
								<h3 class="text-lg font-semibold text-white">Technical Lead II</h3>
								<p class="text-slate-400">HubSpot</p>
							</div>
							<span class="text-sm text-emerald-400 font-medium">Current</span>
						</div>
						<p class="text-slate-400 text-sm leading-relaxed">
							Leading HubSpot's AI Connectors platform - building infrastructure for AI integrations and agent development.
						</p>
					</div>

					<!-- Amazon - Alexa -->
					<div class="card card-hover">
						<div class="mb-3">
							<h3 class="text-lg font-semibold text-white">Software Development Manager</h3>
							<p class="text-slate-400">Amazon &ndash; Alexa</p>
						</div>
						<p class="text-slate-400 text-sm leading-relaxed">
							Led engineering teams building Alexa's voice AI platform.
						</p>
					</div>

					<!-- AWS -->
					<div class="card card-hover">
						<div class="mb-3">
							<h3 class="text-lg font-semibold text-white">Sr. Software Development Engineer</h3>
							<p class="text-slate-400">Amazon Web Services</p>
						</div>
						<p class="text-slate-400 text-sm leading-relaxed">
							Senior engineer building AWS cloud services and infrastructure.
						</p>
					</div>

					<!-- Amazon Retail -->
					<div class="card card-hover">
						<div class="mb-3">
							<h3 class="text-lg font-semibold text-white">Software Development Engineer</h3>
							<p class="text-slate-400">Amazon</p>
						</div>
						<p class="text-slate-400 text-sm leading-relaxed">
							Backend engineering for Amazon's e-commerce platform.
						</p>
					</div>
				</div>
			</section>

			<!-- Links -->
			<section class="border-t border-slate-800 pt-12">
				<div class="flex flex-wrap gap-8 text-sm">
					<a href="/projects" class="text-slate-400 hover:text-white transition-colors">Projects</a>
					<a href="/resume" class="text-slate-400 hover:text-white transition-colors">Resume</a>
					<a href="/blog" class="text-slate-400 hover:text-white transition-colors">Blog</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
