---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StructuredData from '../components/StructuredData.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_AUTHOR, PROFESSIONAL_INFO, SOCIAL_LINKS } from '../consts';
import { getCollection } from 'astro:content';
import { calculateReadingTime } from '../utils/reading-time';

// Get recent blog posts
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const postsWithMeta = posts.map(post => ({
	...post,
	readingMinutes: calculateReadingTime(post.body),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<StructuredData type="person" />
	</head>
	<body>
		<Header />
		<main id="main-content" class="container-custom py-16 md:py-28">
			<!-- Hero Section -->
			<section class="max-w-3xl mx-auto mb-32">
				<h1 class="mb-8">{SITE_AUTHOR}</h1>
				<p class="text-lg md:text-xl text-slate-300 mb-10 leading-relaxed">
					I build backend systems that scale to billions of requests.
					Currently leading platform infrastructure at HubSpot.
				</p>
				<div class="flex flex-wrap gap-3">
					{SOCIAL_LINKS.github && (
						<a
							href={SOCIAL_LINKS.github}
							target="_blank"
							rel="noopener noreferrer"
							class="px-5 py-2.5 border border-slate-600 text-slate-300 hover:border-slate-400 hover:text-white hover:bg-slate-800 transition-all rounded-md text-sm font-medium hover:-translate-y-0.5"
						>
							GitHub
						</a>
					)}
					{SOCIAL_LINKS.linkedin && (
						<a
							href={SOCIAL_LINKS.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							class="px-5 py-2.5 border border-slate-600 text-slate-300 hover:border-slate-400 hover:text-white hover:bg-slate-800 transition-all rounded-md text-sm font-medium hover:-translate-y-0.5"
						>
							LinkedIn
						</a>
					)}
					<a
						href="/blog"
						class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white transition-all rounded-md text-sm font-medium hover:-translate-y-0.5"
					>
						Read my writing
					</a>
				</div>
			</section>

			<!-- Featured Blog Posts Section -->
			{postsWithMeta.length > 0 && (
				<section class="mb-32">
					<h2 class="mb-10">Latest Articles</h2>
					<div class="space-y-6 mb-8">
						{postsWithMeta.map((post) => (
							<a href={`/blog/${post.id}/`} class="group card card-hover block">
								<div class="flex items-center gap-2 mb-3">
									<time class="text-xs text-slate-500 font-medium">
										<FormattedDate date={post.data.pubDate} />
									</time>
									<span class="text-slate-600">•</span>
									<span class="text-xs text-slate-400">{post.readingMinutes} min</span>
								</div>
								<h3 class="text-lg font-semibold text-slate-200 group-hover:text-white transition-colors mb-2">
									{post.data.title}
								</h3>
								<p class="text-slate-400 text-sm leading-relaxed mb-3">
									{post.data.description}
								</p>
								<div class="text-sm text-blue-400 group-hover:text-blue-300 transition-colors">
									Read article →
								</div>
							</a>
						))}
					</div>
					<div class="text-center">
						<a href="/blog" class="text-slate-400 hover:text-white transition-colors text-sm font-medium">
							View all posts →
						</a>
					</div>
				</section>
			)}

			<!-- Experience Section -->
			<section class="mb-32">
				<h2 class="mb-10">Experience</h2>
				<div class="max-w-3xl mx-auto space-y-6">
					<!-- HubSpot -->
					<div class="card card-hover">
						<div class="flex items-start justify-between gap-4 mb-3">
							<div>
								<h3 class="text-lg font-semibold text-white">Technical Lead II</h3>
								<p class="text-slate-400">HubSpot</p>
							</div>
							<span class="text-sm text-emerald-400 font-medium">Current</span>
						</div>
						<p class="text-slate-400 text-sm leading-relaxed">
							Leading HubSpot's AI Connectors platform - building infrastructure for AI integrations and agent development.
						</p>
					</div>

					<!-- Amazon - Alexa -->
					<div class="card card-hover">
						<div class="mb-3">
							<h3 class="text-lg font-semibold text-white">Software Development Manager</h3>
							<p class="text-slate-400">Amazon &ndash; Alexa</p>
						</div>
						<p class="text-slate-400 text-sm leading-relaxed">
							Led engineering teams building Alexa's voice AI platform.
						</p>
					</div>

					<!-- AWS -->
					<div class="card card-hover">
						<div class="mb-3">
							<h3 class="text-lg font-semibold text-white">Sr. Software Development Engineer</h3>
							<p class="text-slate-400">Amazon Web Services</p>
						</div>
						<p class="text-slate-400 text-sm leading-relaxed">
							Senior engineer building AWS cloud services and infrastructure.
						</p>
					</div>

					<!-- Amazon Retail -->
					<div class="card card-hover">
						<div class="mb-3">
							<h3 class="text-lg font-semibold text-white">Software Development Engineer</h3>
							<p class="text-slate-400">Amazon</p>
						</div>
						<p class="text-slate-400 text-sm leading-relaxed">
							Backend engineering for Amazon's e-commerce platform.
						</p>
					</div>
				</div>
			</section>

		</main>
		<Footer />
	</body>
</html>
