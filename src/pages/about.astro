---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE_AUTHOR, PROFESSIONAL_INFO } from '../consts';

const title = 'About Me';
const description = `Learn more about ${SITE_AUTHOR} - ${PROFESSIONAL_INFO.jobTitle}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_AUTHOR}`} description={description} />
		<StructuredData type="person" />
	</head>
	<body>
		<Header />
		<main id="main-content" class="container-custom py-16 md:py-24">
			<article class="about max-w-3xl mx-auto">
				<h1>{title}</h1>

				<section class="bio">
					<h2>Background</h2>
					<p>
						[Your professional background, how you got into software engineering, key career milestones]
					</p>
					<p>
						[What drives you as an engineer, your approach to solving problems, your values]
					</p>
				</section>

				<section class="expertise">
					<h2>Areas of Expertise</h2>
					<ul class="expertise-list">
						<li>
							<strong>Backend Systems:</strong> [Technologies, frameworks, patterns you work with]
						</li>
						<li>
							<strong>Frontend Development:</strong> [Your frontend stack and experience]
						</li>
						<li>
							<strong>Infrastructure & DevOps:</strong> [Cloud platforms, CI/CD, containerization]
						</li>
						<li>
							<strong>System Design:</strong> [Experience with distributed systems, scalability, architecture]
						</li>
						<li>
							<strong>Leadership:</strong> [Team leadership, mentoring, technical decision-making]
						</li>
					</ul>
				</section>

				<section class="technologies">
					<h2>Technologies & Tools</h2>
					<div class="tech-grid">
						<div class="tech-category">
							<h3>Languages</h3>
							<p>[Languages you're proficient in]</p>
						</div>
						<div class="tech-category">
							<h3>Frameworks</h3>
							<p>[Key frameworks and libraries]</p>
						</div>
						<div class="tech-category">
							<h3>Infrastructure</h3>
							<p>[Cloud platforms, databases, message queues]</p>
						</div>
						<div class="tech-category">
							<h3>Tools</h3>
							<p>[Development and productivity tools]</p>
						</div>
					</div>
				</section>

				<section class="interests">
					<h2>Beyond Code</h2>
					<p>
						[Your interests outside of work, open source contributions, speaking engagements, writing, etc.]
					</p>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about {
		width: 100%;
	}

	.about h1 {
		margin-bottom: 3rem;
	}

	.about section {
		margin-bottom: 3rem;
	}

	.about h2 {
		color: #e2e8f0;
		margin-bottom: 1.5rem;
	}

	.about h3 {
		color: #e2e8f0;
		margin-bottom: 1rem;
	}

	.about p {
		color: #cbd5e1;
		line-height: 1.625;
		margin-bottom: 1rem;
	}

	.expertise-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.expertise-list li {
		line-height: 1.625;
		color: #cbd5e1;
		margin-bottom: 1rem;
	}

	.expertise-list strong {
		color: #e2e8f0;
		display: block;
		margin-bottom: 0.25rem;
	}

	.tech-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: 1fr;
		margin-top: 1.5rem;
	}

	@media (min-width: 768px) {
		.tech-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.tech-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.tech-category {
		padding: 1rem;
		background-color: #1e293b;
		border: 1px solid #475569;
		border-radius: 0.5rem;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.tech-category:hover {
		border-color: #334155;
	}

	.tech-category h3 {
		color: #e2e8f0;
		margin-bottom: 0.75rem;
		font-size: 1rem;
		font-weight: 600;
	}

	.tech-category p {
		color: #cbd5e1;
		font-size: 0.875rem;
		line-height: 1.625;
	}
</style>
