---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE_AUTHOR, PROFESSIONAL_INFO } from '../consts';

const title = 'About Me';
const description = `Learn more about ${SITE_AUTHOR} - ${PROFESSIONAL_INFO.jobTitle}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_AUTHOR}`} description={description} />
		<StructuredData type="person" />
	</head>
	<body>
		<Header />
		<main>
			<article class="about">
				<h1>{title}</h1>

				<section class="bio">
					<h2>Background</h2>
					<p>
						[Your professional background, how you got into software engineering, key career milestones]
					</p>
					<p>
						[What drives you as an engineer, your approach to solving problems, your values]
					</p>
				</section>

				<section class="expertise">
					<h2>Areas of Expertise</h2>
					<ul class="expertise-list">
						<li>
							<strong>Backend Systems:</strong> [Technologies, frameworks, patterns you work with]
						</li>
						<li>
							<strong>Frontend Development:</strong> [Your frontend stack and experience]
						</li>
						<li>
							<strong>Infrastructure & DevOps:</strong> [Cloud platforms, CI/CD, containerization]
						</li>
						<li>
							<strong>System Design:</strong> [Experience with distributed systems, scalability, architecture]
						</li>
						<li>
							<strong>Leadership:</strong> [Team leadership, mentoring, technical decision-making]
						</li>
					</ul>
				</section>

				<section class="technologies">
					<h2>Technologies & Tools</h2>
					<div class="tech-grid">
						<div class="tech-category">
							<h3>Languages</h3>
							<p>[Languages you're proficient in]</p>
						</div>
						<div class="tech-category">
							<h3>Frameworks</h3>
							<p>[Key frameworks and libraries]</p>
						</div>
						<div class="tech-category">
							<h3>Infrastructure</h3>
							<p>[Cloud platforms, databases, message queues]</p>
						</div>
						<div class="tech-category">
							<h3>Tools</h3>
							<p>[Development and productivity tools]</p>
						</div>
					</div>
				</section>

				<section class="interests">
					<h2>Beyond Code</h2>
					<p>
						[Your interests outside of work, open source contributions, speaking engagements, writing, etc.]
					</p>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about {
		max-width: 800px;
		margin: 0 auto;
	}

	.about h1 {
		font-size: 2.5rem;
		margin-bottom: 2rem;
	}

	.about section {
		margin: 3rem 0;
	}

	.about h2 {
		font-size: 1.75rem;
		margin-bottom: 1.25rem;
		color: #333;
	}

	.about h3 {
		font-size: 1.25rem;
		margin-bottom: 0.75rem;
		color: #444;
	}

	.about p {
		line-height: 1.7;
		margin-bottom: 1rem;
		color: #555;
	}

	.expertise-list {
		list-style: none;
		padding: 0;
	}

	.expertise-list li {
		margin-bottom: 1.25rem;
		line-height: 1.6;
	}

	.expertise-list strong {
		color: #333;
		display: block;
		margin-bottom: 0.25rem;
	}

	.tech-grid {
		display: grid;
		gap: 2rem;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		margin-top: 1.5rem;
	}

	.tech-category {
		padding: 1.5rem;
		background: #f9f9f9;
		border-radius: 8px;
	}

	.tech-category h3 {
		margin-bottom: 0.75rem;
	}

	.tech-category p {
		color: #666;
		line-height: 1.6;
	}

	/* Dark mode styles */
	@media (prefers-color-scheme: dark) {
		.about h2 {
			color: #f1f5f9;
		}

		.about h3 {
			color: #e2e8f0;
		}

		.about p {
			color: #cbd5e1;
		}

		.expertise-list strong {
			color: #f1f5f9;
		}

		.tech-category {
			background: #1e293b;
		}

		.tech-category p {
			color: #94a3b8;
		}
	}

	:global(.dark) .about h2 {
		color: #f1f5f9;
	}

	:global(.dark) .about h3 {
		color: #e2e8f0;
	}

	:global(.dark) .about p {
		color: #cbd5e1;
	}

	:global(.dark) .expertise-list strong {
		color: #f1f5f9;
	}

	:global(.dark) .tech-category {
		background: #1e293b;
	}

	:global(.dark) .tech-category p {
		color: #94a3b8;
	}
</style>
