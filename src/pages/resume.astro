---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, PROFESSIONAL_INFO } from '../consts';

const title = 'Resume';
const description = `Professional experience and qualifications of ${SITE_AUTHOR}`;

// Structured work experience - fill in with your actual data
const experience = [
	{
		company: '[Company Name]',
		position: '[Your Title]',
		location: '[Location]',
		startDate: '[Month Year]',
		endDate: '[Month Year or "Present"]',
		description: '[Brief overview of your role and responsibilities]',
		achievements: [
			'[Specific achievement with metrics]',
			'[Technical contribution or initiative]',
			'[Leadership or impact highlight]',
		],
		technologies: ['Tech 1', 'Tech 2', 'Tech 3'],
	},
	// Add more positions...
];

const education = [
	{
		institution: '[University Name]',
		degree: '[Degree Type]',
		field: '[Field of Study]',
		year: '[Graduation Year]',
		honors: '[Honors/GPA if relevant]',
	},
	// Add more education...
];

const skills = {
	'Programming Languages': ['[Language 1]', '[Language 2]', '[Language 3]'],
	'Frameworks & Libraries': ['[Framework 1]', '[Framework 2]'],
	'Infrastructure & DevOps': ['[Tool 1]', '[Tool 2]'],
	'Databases': ['[Database 1]', '[Database 2]'],
	'Other': ['[Skill 1]', '[Skill 2]'],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_AUTHOR}`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article class="resume">
				<div class="resume-header">
					<h1>{SITE_AUTHOR}</h1>
					<p class="title">{PROFESSIONAL_INFO.jobTitle}</p>
					<div class="actions">
						<a href="/resume.pdf" class="download-btn" download>[Download PDF]</a>
					</div>
				</div>

				<section class="experience-section">
					<h2>Professional Experience</h2>
					{experience.map((job) => (
						<div class="experience-item">
							<div class="job-header">
								<div>
									<h3>{job.position}</h3>
									<p class="company">{job.company} • {job.location}</p>
								</div>
								<p class="dates">{job.startDate} – {job.endDate}</p>
							</div>
							<p class="description">{job.description}</p>
							<ul class="achievements">
								{job.achievements.map((achievement) => (
									<li>{achievement}</li>
								))}
							</ul>
							<div class="technologies">
								<strong>Technologies:</strong>
								{job.technologies.map((tech, index) => (
									<span>{tech}{index < job.technologies.length - 1 ? ', ' : ''}</span>
								))}
							</div>
						</div>
					))}
				</section>

				<section class="skills-section">
					<h2>Technical Skills</h2>
					<div class="skills-grid">
						{Object.entries(skills).map(([category, skillList]) => (
							<div class="skill-category">
								<h3>{category}</h3>
								<p>{skillList.join(', ')}</p>
							</div>
						))}
					</div>
				</section>

				<section class="education-section">
					<h2>Education</h2>
					{education.map((edu) => (
						<div class="education-item">
							<div class="edu-header">
								<div>
									<h3>{edu.degree} in {edu.field}</h3>
									<p class="institution">{edu.institution}</p>
								</div>
								<p class="year">{edu.year}</p>
							</div>
							{edu.honors && <p class="honors">{edu.honors}</p>}
						</div>
					))}
				</section>
			</article>
		</main>
		<Footer />

		<!-- JSON-LD for machine-readable resume data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: SITE_AUTHOR,
			jobTitle: PROFESSIONAL_INFO.jobTitle,
			knowsAbout: PROFESSIONAL_INFO.keywords,
			alumniOf: education.map(e => ({
				'@type': 'EducationalOrganization',
				name: e.institution,
			})),
		})} />
	</body>
</html>

<style>
	.resume {
		max-width: 900px;
		margin: 0 auto;
	}

	.resume-header {
		margin-bottom: 3rem;
		text-align: center;
		padding-bottom: 2rem;
		border-bottom: 2px solid #e0e0e0;
	}

	.resume-header h1 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}

	.resume-header .title {
		font-size: 1.25rem;
		color: #666;
		margin-bottom: 1.5rem;
	}

	.download-btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		background: #333;
		color: white;
		text-decoration: none;
		border-radius: 6px;
		transition: background 0.2s;
	}

	.download-btn:hover {
		background: #555;
	}

	.experience-section,
	.skills-section,
	.education-section {
		margin: 3rem 0;
	}

	section h2 {
		font-size: 1.75rem;
		margin-bottom: 1.5rem;
		color: #333;
		border-bottom: 1px solid #e0e0e0;
		padding-bottom: 0.5rem;
	}

	.experience-item {
		margin-bottom: 2.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid #f0f0f0;
	}

	.experience-item:last-child {
		border-bottom: none;
	}

	.job-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 0.75rem;
		gap: 1rem;
	}

	.job-header h3 {
		font-size: 1.35rem;
		color: #333;
		margin-bottom: 0.25rem;
	}

	.company {
		color: #666;
		font-size: 1rem;
	}

	.dates {
		color: #888;
		font-size: 0.95rem;
		white-space: nowrap;
	}

	.description {
		line-height: 1.6;
		color: #555;
		margin-bottom: 1rem;
	}

	.achievements {
		margin: 1rem 0;
		padding-left: 1.5rem;
	}

	.achievements li {
		margin-bottom: 0.5rem;
		line-height: 1.6;
		color: #555;
	}

	.technologies {
		margin-top: 1rem;
		font-size: 0.95rem;
		color: #666;
	}

	.technologies strong {
		color: #333;
	}

	.skills-grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
	}

	.skill-category h3 {
		font-size: 1.1rem;
		color: #333;
		margin-bottom: 0.5rem;
	}

	.skill-category p {
		line-height: 1.6;
		color: #555;
	}

	.education-item {
		margin-bottom: 1.5rem;
	}

	.edu-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
	}

	.edu-header h3 {
		font-size: 1.25rem;
		color: #333;
		margin-bottom: 0.25rem;
	}

	.institution {
		color: #666;
	}

	.year {
		color: #888;
		white-space: nowrap;
	}

	.honors {
		margin-top: 0.5rem;
		color: #555;
		font-style: italic;
	}

	@media (max-width: 768px) {
		.job-header,
		.edu-header {
			flex-direction: column;
		}

		.dates,
		.year {
			white-space: normal;
		}
	}
</style>
