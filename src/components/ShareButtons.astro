---
export interface Props {
  title: string;
  url: string;
  description?: string;
}

const { title, url, description } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const shareLinks = {
  twitter: `https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  bluesky: `https://bsky.app/intent/compose?text=${encodedTitle}%20${encodedUrl}`,
  email: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`,
};
---

<div class="my-8 flex flex-wrap gap-3">
  <a href={shareLinks.twitter} target="_blank" rel="noopener"
     class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 transition text-sm font-medium">
    Share on X
  </a>
  <a href={shareLinks.linkedin} target="_blank" rel="noopener"
     class="px-4 py-2 bg-blue-700 text-white rounded hover:bg-blue-800 transition text-sm font-medium">
    Share on LinkedIn
  </a>
  <a href={shareLinks.bluesky} target="_blank" rel="noopener"
     class="px-4 py-2 bg-blue-400 text-white rounded hover:bg-blue-500 transition text-sm font-medium">
    Share on Bluesky
  </a>
  <a href={shareLinks.email}
     class="px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 transition text-sm font-medium">
    Email
  </a>
</div>
