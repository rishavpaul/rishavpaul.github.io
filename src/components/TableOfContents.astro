---
interface Props {
	headings: Array<{
		depth: number;
		slug: string;
		text: string;
	}>;
}

const { headings } = Astro.props;

// Filter for h2 and h3 headings only
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{toc && toc.length > 0 && (
	<nav class="hidden lg:block sticky top-24 max-h-[calc(100vh-6rem)] overflow-auto">
		<div class="text-sm text-slate-400">
			<p class="font-semibold text-slate-300 mb-3">On this page</p>
			<ul class="space-y-2">
				{toc.map((heading) => (
					<li
						class={heading.depth === 3 ? 'ml-4' : ''}
					>
						<a
							href={`#${heading.slug}`}
							class="text-slate-400 hover:text-slate-200 transition-colors block py-1"
						>
							{heading.text}
						</a>
					</li>
				))}
			</ul>
		</div>
	</nav>
)}
