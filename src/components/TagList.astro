---
interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{tags && tags.length > 0 && (
	<div class="flex flex-wrap gap-2">
		{tags.map((tag) => (
			<span class="inline-block bg-slate-800 text-slate-300 px-2.5 py-1 rounded-md text-sm hover:bg-slate-700 transition-colors">
				{tag}
			</span>
		))}
	</div>
)}
